{
  "name": "@amplifier/ahp-client-kit",
  "version": "0.1.0",
  "type": "module",
  "description": "AHP resource recovery and durable intent primitives for independent clients",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./indexeddb": "./src/indexeddb.js",
    "./headless": {
      "types": "./src/headless.d.ts",
      "import": "./src/headless.js"
    },
    "./file-storage": {
      "types": "./src/file-storage.d.ts",
      "import": "./src/file-storage.js"
    },
    "./cli": "./src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@microsoft/agent-host-protocol": "^0.9.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.0"
  },
  "types": "./src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/amplifier-ahp-client-kit.git"
  },
  "bin": {
    "amplifier-ahp": "./src/cli.js"
  },
  "engines": {
    "node": ">=22.16"
  }
}
